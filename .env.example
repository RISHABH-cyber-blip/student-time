# Copy this file to .env for local dev, and add the same keys in Vercel/Netlify's
# environment variable settings when you deploy.
# Vite only exposes variables prefixed with VITE_ to the frontend — never put
# your Gemini key here, it lives as a Supabase Edge Function secret instead.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

GEMINI_API_KEY=